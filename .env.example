# Copy this file to .env.local and set your values
# .env.local is gitignored — never commit real values

# WordPress site running sparxstar-3iatlas-rlc plugin.
# Used by the Vite dev proxy to forward /aiwa/* → {VITE_WP_URL}/wp-json/aiwa/*
VITE_WP_URL=http://localhost:8888

# ── Runtime configuration injected by the host page ──────────────────────────
#
# The client reads its base URL and the teacher's Helios JWT from `window`,
# not from Vite env. The WordPress plugin's asset loader is responsible for:
#
#   window.RLC_API_BASE     = "/wp-json/aiwa/v1"          // optional in dev (defaults to /aiwa/v1)
#   window.RLC_TEACHER_TOKEN = "<helios-bearer-token>"     // required for teacher endpoints
#
# For local dev without the plugin injecting these, set them in the browser
# console (persists across reloads via localStorage):
#
#   localStorage.setItem('RLC_TEACHER_TOKEN', '<your-dev-jwt>')
#
# See docs at .github/instructions/INTEGRATION-CONTRACT.md
