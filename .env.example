# Copy this file to .env.local and set your values
# .env.local is gitignored — never commit real values

# Node backend (sparxstar-3iatlas-rlc-node-engine).
# Used by the Vite dev proxy to forward /api/* → {VITE_RLC_BACKEND_URL}/api/*
VITE_RLC_BACKEND_URL=http://localhost:3001

# ── Runtime configuration injected by the host page ──────────────────────────
#
# The client reads its base URL, teacher JWT, and school ID from `window`,
# not from Vite env. The orchestrator (or host page) is responsible for:
#
#   window.RLC_API_BASE      = "https://backend.example/api/v1"  // optional in dev
#   window.RLC_TEACHER_TOKEN = "<backend-issued JWT>"            // teacher sessions only
#   window.RLC_SCHOOL_ID     = "<school UUID>"                   // required for join
#
# For local dev without a host page injecting these, set them in the browser
# console for the current page only:
#
#   window.RLC_TEACHER_TOKEN = '<your-dev-jwt>'
#
# There is no UI login endpoint. Obtain the development JWT through the
# orchestrator/backend provisioning flow documented by the deployment.
